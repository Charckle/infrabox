ENVCONFIG=PROD
SECRET_KEY=change-me-to-a-random-50-char-string-before-deploying
APP_NAME=InfraBox
APP_LOGGING=INFO
DATA_DIR=/app/data
WTF_CSRF_ENABLED=True
# Instance-wide lock: no add/edit/delete (setup and password changes blocked).
# Login, logout, import, and export still work.
READ_ONLY_MODE=False
